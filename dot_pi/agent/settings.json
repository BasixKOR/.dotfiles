{
  "lastChangelogVersion": "0.99.1",
  "theme": "dark/dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "packages": [
    "git:github.com/paoloanzn/pi-black",
    "npm:pi-verdict",
    {
      "source": "npm:@aliou/pi-synthetic",
      "extensions": [
        "-extensions/command-quotas/index.ts",
        "-extensions/quota-warnings/index.ts",
        "-extensions/web-search/index.ts",
        "-extensions/usage-status/index.ts",
        "-extensions/sub-bar-integration/index.ts"
      ]
    },
    "npm:@tintinweb/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-antigravity",
    "npm:@narumitw/pi-btw",
    "npm:pi-advisor-flow"
  ],
  "skills": [
    "!skills/synced/**"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  }
}